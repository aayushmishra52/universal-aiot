# Firebase web config for the dashboard (optional, enables the
# "Continue with Firebase" email/password panel on the login page).
#
# HOW TO USE:
#   1. Copy this file to `.env.local`  (gitignored — real values live ONLY there)
#   2. Fill in the seven values from your Firebase console:
#        Project settings → General → "Your apps" → your web app
#        (sign-in provider: Build → Authentication → Sign-in method)
#   3. Backend: set FIREBASE_PROJECT_ID to the same project so it can
#      verify ID tokens (see docs/FIREBASE-AUTH.md).
#
# Placeholders only — never put real keys in this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
