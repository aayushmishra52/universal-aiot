# Universal AIoT — copy to .env, never commit real secrets.
# Backend
PORT=4000
MQTT_PORT=1883
WS_PORT=4001
DATABASE_URL=file:./data/aiot.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=600
SWEEP_INTERVAL_MS=10000
PAIRING_TTL_HOURS=24
# Frontend (Vite) — do NOT append /api here; the dashboard adds it automatically.
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001
