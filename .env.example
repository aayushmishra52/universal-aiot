# Universal AIoT — copy to .env, never commit real secrets.
# Backend
PORT=4000
MQTT_PORT=1883
WS_PORT=4001
HTTP_HOST=127.0.0.1
MQTT_HOST=127.0.0.1
DATABASE_URL=file:./data/aiot.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=600
SWEEP_INTERVAL_MS=10000
PAIRING_TTL_HOURS=24
# Public URLs advertised to dashboard/SDK ("connect from anywhere")
PUBLIC_MQTT_URL=
PUBLIC_API_URL=
# TLS for the embedded MQTT broker (key + cert both required to enable)
MQTT_TLS_PORT=8883
MQTT_TLS_KEY=
MQTT_TLS_CERT=
# TLS for the HTTPS API (key + cert both required)
TLS_KEY=
TLS_CERT=
# Optional Firebase Auth (free tier). When FIREBASE_PROJECT_ID is set, the
# backend accepts Firebase ID tokens at POST /api/auth/firebase.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Frontend (Vite)
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001
