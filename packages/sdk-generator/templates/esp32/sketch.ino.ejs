/**
 * <%= deviceName %> — Universal AIoT device firmware.
 * Generated by aiot-sdk <%= generatorVersion %>.
 *
 * Board: <%= board.name %> (<%= board.fqbn %>)
 * Device: <%= deviceId %> | Project: <%= projectId %> | Org: <%= orgId %>
 *
 * Fill in config/config.h (copy from config.example.h), then:
 *   aiot-sdk build
 *   aiot-sdk flash --port /dev/ttyUSB0
 */
#include <AIoT.h>
#include <esp_arduino_version.h>

#include "config/config.h"
#include "manifest_json.h"
<% for (const inc of plan.includes) { -%>
#include "<%= inc %>"
<% } -%>

AIoT device;

<% for (const decl of plan.adapterDecls) { -%>
<%= decl %>
<% } -%>
<% for (const helper of plan.actuatorHelpers) { -%>
<%= helper %>

<% } -%>
void setup() {
  Serial.begin(115200);
  delay(250);
  AIOT_LOG(F("boot: <%= deviceName %> (<%= deviceId %>)"));

<% for (const b of plan.adapterBegins) { -%>
  <%= b %>
<% } -%>
  AIoTConfig cfg;
  cfg.deviceId = DEVICE_ID;
  cfg.projectId = PROJECT_ID;
  cfg.orgId = ORG_ID;
  cfg.deviceName = DEVICE_NAME;
  cfg.wifiSsid = WIFI_SSID;
  cfg.wifiPass = WIFI_PASS;
  cfg.mqttHost = MQTT_HOST;
  cfg.mqttPort = MQTT_PORT;
  cfg.mqttUser = MQTT_USER;
  cfg.mqttPass = MQTT_PASS;
  cfg.tls = MQTT_TLS;
  cfg.manifestJson = MANIFEST_JSON;
  if (!device.begin(cfg)) {
    AIOT_LOG(F("fatal: device.begin() failed — check config/config.h"));
    for (;;) {
      delay(1000);
    }
  }

<% for (const r of plan.sensorRegisters) { -%>
  <%= r %>
<% } -%>
<% for (const s of plan.actuatorSetups) { -%>
  <%= s %>
<% } -%>
<% for (const r of plan.actuatorRegister) { -%>
  <%= r %>
<% } -%>
}

void loop() { device.loop(); }
