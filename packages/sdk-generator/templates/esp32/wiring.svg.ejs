<svg xmlns="http://www.w3.org/2000/svg" width="720" height="<%= 120 + plan.wiring.length * 72 %>" viewBox="0 0 720 <%= 120 + plan.wiring.length * 72 %>" font-family="monospace">
  <rect x="0" y="0" width="720" height="<%= 120 + plan.wiring.length * 72 %>" fill="#0f172a"/>
  <text x="24" y="36" fill="#e2e8f0" font-size="18"><%= deviceName %> — wiring</text>
  <text x="24" y="60" fill="#94a3b8" font-size="12"><%= board.name %> · <%= deviceId %></text>
  <rect x="24" y="80" width="150" height="<%= plan.wiring.length * 72 %>" rx="8" fill="#1e293b" stroke="#334155"/>
  <text x="40" y="104" fill="#e2e8f0" font-size="13">ESP32</text>
<% plan.wiring.forEach(function(w, i) {
  const y = 80 + i * 72;
  const cy = y + 36;
  const colors = { vcc: '#ef4444', gnd: '#9ca3af', signal: w.kind === 'sensor' ? '#38bdf8' : '#fbbf24' };
-%>
  <text x="40" y="<%= y + 28 %>" fill="#e2e8f0" font-size="11">GPIO <%= w.pin %></text>
  <text x="40" y="<%= y + 46 %>" fill="#64748b" font-size="10">3V3 · GND</text>
  <rect x="380" y="<%= y + 6 %>" width="316" height="60" rx="8" fill="#1e293b" stroke="#334155"/>
  <text x="396" y="<%= y + 30 %>" fill="#e2e8f0" font-size="12"><%= w.label %></text>
  <text x="396" y="<%= y + 50 %>" fill="#64748b" font-size="10"><%= w.kind %> · <%= w.signal %></text>
  <line x1="174" y1="<%= cy - 12 %>" x2="380" y2="<%= cy - 12 %>" stroke="<%= colors.vcc %>" stroke-width="2.5"/>
  <text x="270" y="<%= cy - 16 %>" fill="<%= colors.vcc %>" font-size="9" text-anchor="middle">VCC</text>
  <line x1="174" y1="<%= cy %>" x2="380" y2="<%= cy %>" stroke="<%= colors.gnd %>" stroke-width="2.5"/>
  <text x="270" y="<%= cy - 4 %>" fill="<%= colors.gnd %>" font-size="9" text-anchor="middle">GND</text>
  <line x1="174" y1="<%= cy + 12 %>" x2="380" y2="<%= cy + 12 %>" stroke="<%= colors.signal %>" stroke-width="2.5"/>
  <text x="270" y="<%= cy + 24 %>" fill="<%= colors.signal %>" font-size="9" text-anchor="middle">GPIO <%= w.pin %></text>
<% }); -%>
</svg>
