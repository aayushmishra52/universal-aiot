# arduino-cli sketch profile — generated by aiot-sdk <%= generatorVersion %>.
#
# Pinned, verified versions (see PINNED_VERSIONS.md in the aiot-sdk package):
#   ESP32 Arduino core ......... <%= versions.esp32Core %>
#   ArduinoJson ................ <%= versions.arduinoJson %>
#   espMqttClient .............. <%= versions.espMqttClient %> (upstream GitHub release, not in Library Manager)
#   AsyncTCP ................... <%= versions.asyncTcp %>
<% if (plan.includes.some(i => i.includes('dht22'))) { -%>
#   DHT sensor library ......... <%= versions.dhtSensor %>
#   Adafruit Unified Sensor .... <%= versions.adafruitUnified %>
<% } -%>
#
# The platform entry carries no version on purpose: arduino-cli then uses
# the system-installed ESP32 core (installed by `aiot-sdk repair`) instead
# of re-downloading it into an isolated profile cache. Libraries are
# referenced by directory for the same reason — the pinned versions above
# are installed by `aiot-sdk repair` into your sketchbook libraries dir.
# If you move the sketchbook, update the `dir:` paths below.
#
# Compile with:  arduino-cli compile --profile <%= boardId %>
# (or: aiot-sdk build)
profiles:
  <%= boardId %>:
    fqbn: <%= board.fqbn %>
    platforms:
      - platform: <%= platformRef %>
    libraries:
      - dir: <%= libraryDir %>/ArduinoJson
      - dir: <%= libraryDir %>/espMqttClient
      - dir: <%= libraryDir %>/AsyncTCP
<% if (plan.includes.some(i => i.includes('dht22'))) { -%>
      - dir: <%= libraryDir %>/DHT_sensor_library
      - dir: <%= libraryDir %>/Adafruit_Unified_Sensor
<% } -%>
default_profile: <%= boardId %>
