/**
 * AIoT device runtime — generated by aiot-sdk <%= generatorVersion %>.
 *
 * Public API:
 *   #include <AIoT.h>
 *   AIoT device;
 *   AIoTConfig cfg = { ... };   // deviceId, projectId, orgId, wifiSsid,
 *                               // wifiPass, mqttHost, mqttPort, mqttUser,
 *                               // mqttPass, tls, manifestJson
 *   device.begin(cfg);
 *   device.sensor("temperature", readFn);            // float readFn()
 *   device.sensor("humidity", readFn, 5000);         // with interval (ms)
 *   device.actuator("fan", writeFn);                 // void writeFn(bool)
 *   device.actuator("servo", writeFn, 0, 180, 90);   // void writeFn(float)
 *   device.loop();                                   // call every loop()
 *
 * The runtime owns the whole device lifecycle: WiFi, MQTT (espMqttClient
 * behind the MqttTransport interface), manifest/telemetry/command/status/
 * health/presence JSON via ArduinoJson, a bounded telemetry queue, command
 * de-duplication and expiry, and a task watchdog. Secrets are never logged.
 */
#pragma once

#include <Arduino.h>

#include <functional>
#include <map>
#include <string>
#include <vector>

#ifndef AIOT_FIRMWARE_VERSION
#define AIOT_FIRMWARE_VERSION "<%= firmwareVersion %>"
#endif
#define AIOT_PROTOCOL_VERSION "1.0"

// Logging helpers. Never pass secrets (passwords, tokens) to these.
#define AIOT_LOG(msg)                                    \
  do {                                                   \
    Serial.print(F("[AIOT] "));                          \
    Serial.println(msg);                                 \
  } while (0)
#define AIOT_LOGF(fmt, ...)                              \
  do {                                                   \
    Serial.print(F("[AIOT] "));                          \
    Serial.printf((fmt), ##__VA_ARGS__);                 \
    Serial.println();                                    \
  } while (0)

struct AIoTConfig {
  const char* deviceId = nullptr;
  const char* projectId = nullptr;
  const char* orgId = nullptr;
  const char* deviceName = nullptr;
  const char* wifiSsid = nullptr;
  const char* wifiPass = nullptr;
  const char* mqttHost = nullptr;
  uint16_t mqttPort = 1883;
  const char* mqttUser = nullptr;
  const char* mqttPass = nullptr;
  bool tls = false;
  /** Canonical manifest JSON, published retained on the manifest topic. */
  const char* manifestJson = nullptr;
};

enum class AIoTState : uint8_t {
  BOOT,
  SELF_TEST,
  NETWORK_CONNECTING,
  MQTT_CONNECTING,
  REGISTERING,
  ONLINE,
  OFFLINE,
  RECONNECTING,
};

const char* aiotStateName(AIoTState state);

/**
 * MQTT transport abstraction. The production implementation wraps
 * espMqttClient (never PubSubClient). Tests can inject a fake.
 */
class MqttTransport {
 public:
  using MessageCallback = std::function<void(const char* topic,
                                             const uint8_t* payload,
                                             size_t length)>;
  using ConnectCallback = std::function<void(bool sessionPresent)>;
  using DisconnectCallback = std::function<void(int reason)>;

  virtual ~MqttTransport() = default;

  virtual bool open(const char* host, uint16_t port, const char* clientId,
                    const char* username, const char* password, bool tls,
                    const char* willTopic, const uint8_t* willPayload,
                    size_t willLength) = 0;
  virtual void close() = 0;
  virtual bool isConnected() = 0;
  virtual bool publish(const char* topic, const uint8_t* payload,
                       size_t length, uint8_t qos, bool retain) = 0;
  virtual bool subscribe(const char* topic, uint8_t qos) = 0;
  virtual void poll() = 0;
  virtual void setMessageCallback(MessageCallback cb) = 0;
  virtual void setConnectCallback(ConnectCallback cb) = 0;
  virtual void setDisconnectCallback(DisconnectCallback cb) = 0;
};

/** Base class for sensor adapters (see adapters/*.h). */
class SensorAdapter {
 public:
  virtual ~SensorAdapter() = default;
  virtual bool begin() = 0;
  virtual bool readValue(const char* capabilityId, float& value) = 0;
};

class AIoT {
 public:
  using SensorReadFn = std::function<float()>;
  using BoolWriteFn = std::function<void(bool)>;
  using NumWriteFn = std::function<void(float)>;

  AIoT();
  ~AIoT();

  AIoT(const AIoT&) = delete;
  AIoT& operator=(const AIoT&) = delete;

  /**
   * Validate the config, start the watchdog and enter the BOOT state.
   * Sensors/actuators may be registered before or after begin(); safe
   * actuator defaults are applied at registration time and again at boot.
   */
  bool begin(const AIoTConfig& config);

  /** Inject a custom transport (used by tests). Takes ownership. */
  void setTransport(MqttTransport* transport);

  /** Register a sensor channel. Default sampling interval: 10 s. */
  bool sensor(const char* capabilityId, SensorReadFn readFn);
  bool sensor(const char* capabilityId, SensorReadFn readFn,
              uint32_t intervalMs);

  /** Register a boolean actuator (led, relay, fan). */
  bool actuator(const char* capabilityId, BoolWriteFn writeFn,
                bool safeDefault = false);
  /** Register a numeric actuator (fan_speed, servo) with range clamping. */
  bool actuator(const char* capabilityId, NumWriteFn writeFn, float minValue,
                float maxValue, float safeDefault = 0.0f);

  /** Drive the state machine, scheduler, queue and watchdog. Call often. */
  void loop();

  AIoTState state() const { return state_; }

 private:
  struct SensorChannel {
    String id;
    SensorReadFn fn;
    uint32_t intervalMs = 10000;
    uint32_t lastRunMs = 0;
  };

  struct ActuatorChannel {
    String id;
    bool isBool = true;
    BoolWriteFn boolFn;
    NumWriteFn numFn;
    float minValue = 0.0f;
    float maxValue = 1.0f;
    /** Last reported state, stored as a JSON fragment ("true", "23.50"). */
    String reported;
  };

  struct QueuedMessage {
    uint8_t priority = 0;  // 0 = telemetry (droppable), 1 = protocol (keep)
    uint8_t qos = 0;
    bool retain = false;
    char topic[128] = {0};
    uint8_t payload[768] = {0};
    size_t length = 0;
  };

  static constexpr size_t kQueueMax = 20;
  static constexpr size_t kCommandCacheSize = 50;
  static constexpr size_t kMaxInboundPayload = 2048;

  void setState(AIoTState next);
  void runStateMachine();
  void runScheduler();
  void pumpQueue();
  void maybeSyncTime();
  uint64_t currentTimeMs();

  void startMqttConnect();
  void doRegistration();
  void onMqttConnected(bool sessionPresent);
  void onMqttDisconnected(int reason);
  void onMqttMessage(const char* topic, const uint8_t* payload, size_t length);

  void handleCommand(const uint8_t* payload, size_t length);
  bool isDuplicateCommand(const String& commandId);
  void rememberCommand(const String& commandId);
  ActuatorChannel* findActuator(const char* capabilityId);

  void enqueue(const char* topic, const uint8_t* payload, size_t length,
               uint8_t qos, bool retain, uint8_t priority);
  void enqueueJson(const char* topic, const char* json, uint8_t qos,
                   bool retain, uint8_t priority);

  void publishStatus();
  void publishTelemetry(const String& capabilityId, float value);
  void publishHealth();
  void publishPresence(bool online);
  void publishCommandResult(const String& commandId, const char* status,
                            const char* reason, ActuatorChannel* act);

  AIoTConfig cfg_;
  AIoTState state_ = AIoTState::BOOT;
  MqttTransport* transport_ = nullptr;

  std::vector<SensorChannel> sensors_;
  std::vector<ActuatorChannel> actuators_;
  std::vector<QueuedMessage> queue_;

  char topicManifest_[128] = {0};
  char topicStatus_[128] = {0};
  char topicTelemetry_[128] = {0};
  char topicCommand_[128] = {0};
  char topicPresence_[128] = {0};
  char topicHealth_[128] = {0};

  String commandCache_[kCommandCacheSize];
  size_t commandCachePos_ = 0;

  uint32_t stateEnteredMs_ = 0;
  uint32_t lastHeartbeatMs_ = 0;
  uint32_t lastNtpPollMs_ = 0;
  uint32_t reconnectDelayMs_ = 5000;
  uint32_t sequence_ = 0;
  uint32_t sensorErrors_ = 0;
  uint32_t lastTelemetryAt_ = 0;
  std::map<String, String> capabilityHealth_;
  bool timeSynced_ = false;
  bool mqttSession_ = false;
};
