/**
 * Analog (ADC) sensor adapter — generated by aiot-sdk.
 * Reads the ADC voltage on the configured pin (12-bit, 0..3.3 V).
 */
#pragma once

#include <Arduino.h>

#include <AIoT.h>

class AnalogAdapter : public SensorAdapter {
 public:
  explicit AnalogAdapter(uint8_t pin) : pin_(pin) {}

  bool begin() override {
    analogReadResolution(12);
    pinMode(pin_, INPUT);
    return true;
  }

  bool readValue(const char* capabilityId, float& value) override {
    (void)capabilityId;
    value = readVoltage();
    return true;
  }

  float readVoltage() { return (float)analogRead(pin_) * 3.3f / 4095.0f; }
  float readRaw() { return (float)analogRead(pin_); }

 private:
  uint8_t pin_;
};
