/**
 * Digital (GPIO) sensor adapter — generated by aiot-sdk.
 * Reads a digital input pin (e.g. PIR motion sensor, push button).
 */
#pragma once

#include <Arduino.h>

#include <AIoT.h>

class DigitalAdapter : public SensorAdapter {
 public:
  explicit DigitalAdapter(uint8_t pin, uint8_t mode = INPUT_PULLUP)
      : pin_(pin), mode_(mode) {}

  bool begin() override {
    pinMode(pin_, mode_);
    return true;
  }

  bool readValue(const char* capabilityId, float& value) override {
    (void)capabilityId;
    value = read() ? 1.0f : 0.0f;
    return true;
  }

  bool read() { return digitalRead(pin_) == HIGH; }

 private:
  uint8_t pin_;
  uint8_t mode_;
};
