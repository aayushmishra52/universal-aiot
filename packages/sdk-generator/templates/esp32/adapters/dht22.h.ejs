/**
 * DHT22 sensor adapter — generated by aiot-sdk.
 * Produces the "temperature" and "humidity" capabilities from one sensor.
 * Requires the DHT sensor library (Adafruit).
 */
#pragma once

#include <Arduino.h>

#include <AIoT.h>
#include <DHT.h>

class Dht22Adapter : public SensorAdapter {
 public:
  explicit Dht22Adapter(uint8_t pin) : pin_(pin), dht_(pin, DHT22) {}

  bool begin() override {
    dht_.begin();
    return true;
  }

  bool readValue(const char* capabilityId, float& value) override {
    if (strcmp(capabilityId, "temperature") == 0) {
      value = readTemperature();
    } else if (strcmp(capabilityId, "humidity") == 0) {
      value = readHumidity();
    } else {
      return false;
    }
    // DHT22 needs ~2 s between reads; NaN means the read failed.
    return !isnan(value);
  }

  float readTemperature() { return dht_.readTemperature(); }
  float readHumidity() { return dht_.readHumidity(); }

 private:
  uint8_t pin_;
  DHT dht_;
};
