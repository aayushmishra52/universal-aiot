/**
 * AIoT device runtime implementation — generated by aiot-sdk.
 *
 * State machine:
 *   BOOT -> SELF_TEST -> NETWORK_CONNECTING -> MQTT_CONNECTING ->
 *   REGISTERING -> ONLINE, with OFFLINE / RECONNECTING on failures.
 *
 * Conventions: non-blocking millis() scheduler, bounded telemetry queue
 * (max 20, oldest low-priority dropped first), command de-duplication
 * (last 50 commandIds), command expiry against NTP time when synced,
 * parameter min/max validation, desired-vs-reported state tracking,
 * ACK-then-RESULT on the command topic, retained LWT presence, and a
 * 30 s task watchdog. No secrets are ever logged.
 */
#include "AIoT.h"

#include <WiFi.h>
#include <ArduinoJson.h>
#include <espMqttClient.h>
#include <esp_task_wdt.h>
#include <esp_arduino_version.h>

namespace {

constexpr uint32_t kHeartbeatMs = 30000;
constexpr uint32_t kWifiTimeoutMs = 25000;
constexpr uint32_t kMqttTimeoutMs = 20000;
constexpr uint32_t kSubscribeTimeoutMs = 10000;
constexpr uint32_t kReconnectMaxMs = 60000;
constexpr uint32_t kNtpPollMs = 60000;
constexpr uint32_t kWdtTimeoutMs = 30000;
constexpr size_t kMaxInboundPayload = 2048;

// ---------------------------------------------------------------------------
// espMqttClient transport (production). Uses the synchronous client
// (UseInternalTask::NO) so all MQTT work is driven by poll() -> loop().
// ---------------------------------------------------------------------------
class EspMqttClientTransport : public MqttTransport {
 public:
  EspMqttClientTransport() = default;
  ~EspMqttClientTransport() override { close(); }

  bool open(const char* host, uint16_t port, const char* clientId,
            const char* username, const char* password, bool tls,
            const char* willTopic, const uint8_t* willPayload,
            size_t willLength) override {
    close();
    if (tls) {
      secure_ = new espMqttClientSecure();
      // MVP: no CA bundle shipped; hostname verification is skipped.
      // Provide cfg.tls with a CA via setCACert() for production use.
      secure_->setInsecure();
      configure(*secure_, host, port, clientId, username, password, willTopic,
                willPayload, willLength);
      active_ = secure_;
    } else {
      plain_ = new espMqttClient();
      configure(*plain_, host, port, clientId, username, password, willTopic,
                willPayload, willLength);
      active_ = plain_;
    }
    return active_->connect();
  }

  void close() override {
    if (active_) active_->disconnect();
    delete plain_;
    plain_ = nullptr;
    delete secure_;
    secure_ = nullptr;
    active_ = nullptr;
    chunk_.clear();
  }

  bool isConnected() override { return active_ && active_->connected(); }

  bool publish(const char* topic, const uint8_t* payload, size_t length,
               uint8_t qos, bool retain) override {
    if (!active_) return false;
    return active_->publish(topic, qos, retain, payload, length) != 0;
  }

  bool subscribe(const char* topic, uint8_t qos) override {
    if (!active_) return false;
    return active_->subscribe(topic, qos) != 0;
  }

  void poll() override {
    if (active_) active_->loop();
  }

  void setMessageCallback(MessageCallback cb) override { messageCb_ = cb; }
  void setConnectCallback(ConnectCallback cb) override { connectCb_ = cb; }
  void setDisconnectCallback(DisconnectCallback cb) override {
    disconnectCb_ = cb;
  }

 private:
  template <typename T>
  void configure(T& client, const char* host, uint16_t port,
                 const char* clientId, const char* username,
                 const char* password, const char* willTopic,
                 const uint8_t* willPayload, size_t willLength) {
    client.setServer(host, port);
    client.setClientId(clientId ? clientId : "aiot-device");
    if (username && username[0]) {
      client.setCredentials(username, password ? password : "");
    }
    if (willTopic && willPayload) {
      client.setWill(willTopic, 1, true, willPayload, willLength);
    }
    client.setKeepAlive(30);
    client.setCleanSession(true);
    client.onConnect([this](bool sessionPresent) {
      if (connectCb_) connectCb_(sessionPresent);
    });
    client.onDisconnect([this](espMqttClientTypes::DisconnectReason reason) {
      if (disconnectCb_) disconnectCb_(static_cast<int>(reason));
    });
    client.onMessage([this](const espMqttClientTypes::MessageProperties& props,
                            const char* topic, const uint8_t* payload,
                            size_t len, size_t index, size_t total) {
      (void)props;
      // Reassemble chunked deliveries; drop anything oversized.
      if (total > kMaxInboundPayload) {
        chunk_.clear();
        return;
      }
      if (index == 0) {
        chunk_.clear();
        chunkTopic_ = topic ? topic : "";
      }
      chunk_.insert(chunk_.end(), payload, payload + len);
      if (index + len >= total) {
        if (messageCb_ && !chunkTopic_.empty()) {
          messageCb_(chunkTopic_.c_str(), chunk_.data(), chunk_.size());
        }
        chunk_.clear();
      }
    });
  }

  MqttClient* active_ = nullptr;
  espMqttClient* plain_ = nullptr;
  espMqttClientSecure* secure_ = nullptr;
  MessageCallback messageCb_;
  ConnectCallback connectCb_;
  DisconnectCallback disconnectCb_;
  std::vector<uint8_t> chunk_;
  std::string chunkTopic_;
};

}  // namespace

const char* aiotStateName(AIoTState state) {
  switch (state) {
    case AIoTState::BOOT: return "BOOT";
    case AIoTState::SELF_TEST: return "SELF_TEST";
    case AIoTState::NETWORK_CONNECTING: return "NETWORK_CONNECTING";
    case AIoTState::MQTT_CONNECTING: return "MQTT_CONNECTING";
    case AIoTState::REGISTERING: return "REGISTERING";
    case AIoTState::ONLINE: return "ONLINE";
    case AIoTState::OFFLINE: return "OFFLINE";
    case AIoTState::RECONNECTING: return "RECONNECTING";
  }
  return "UNKNOWN";
}

AIoT::AIoT() = default;

AIoT::~AIoT() { delete transport_; }

void AIoT::setTransport(MqttTransport* transport) {
  delete transport_;
  transport_ = transport;
}

bool AIoT::begin(const AIoTConfig& config) {
  if (!config.deviceId || !config.deviceId[0] || !config.projectId ||
      !config.projectId[0] || !config.orgId || !config.orgId[0] ||
      !config.mqttHost || !config.mqttHost[0] || !config.wifiSsid ||
      !config.wifiSsid[0]) {
    AIOT_LOG(F("begin: invalid config (deviceId/projectId/orgId/mqttHost/wifiSsid required)"));
    return false;
  }
  cfg_ = config;

  snprintf(topicManifest_, sizeof(topicManifest_), "aiot/v1/%s/%s/%s/manifest",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);
  snprintf(topicStatus_, sizeof(topicStatus_), "aiot/v1/%s/%s/%s/status",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);
  snprintf(topicTelemetry_, sizeof(topicTelemetry_), "aiot/v1/%s/%s/%s/telemetry",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);
  snprintf(topicCommand_, sizeof(topicCommand_), "aiot/v1/%s/%s/%s/command",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);
  snprintf(topicPresence_, sizeof(topicPresence_), "aiot/v1/%s/%s/%s/presence",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);
  snprintf(topicHealth_, sizeof(topicHealth_), "aiot/v1/%s/%s/%s/health",
           cfg_.orgId, cfg_.projectId, cfg_.deviceId);

  // Task watchdog: 30 s. Tolerate pre-initialised watchdog (core default).
#if ESP_ARDUINO_VERSION >= ESP_ARDUINO_VERSION_VAL(3, 0, 0)
  esp_task_wdt_config_t wdtConfig;
  wdtConfig.timeout_ms = kWdtTimeoutMs;
  wdtConfig.idle_core_mask = 0;
  wdtConfig.trigger_panic = true;
  (void)esp_task_wdt_init(&wdtConfig);
#else
  (void)esp_task_wdt_init(kWdtTimeoutMs / 1000, true);
#endif
  (void)esp_task_wdt_add(NULL);

  // Safe defaults for actuators registered before begin().
  for (auto& a : actuators_) {
    if (a.isBool && a.boolFn) {
      a.boolFn(a.minValue >= 0.5f);
    } else if (!a.isBool && a.numFn) {
      a.numFn(a.minValue);
    }
  }

  AIOT_LOGF("firmware %s protocol %s device %s", AIOT_FIRMWARE_VERSION,
            AIOT_PROTOCOL_VERSION, cfg_.deviceId);
  setState(AIoTState::BOOT);
  return true;
}

bool AIoT::sensor(const char* capabilityId, SensorReadFn readFn) {
  return sensor(capabilityId, readFn, 10000);
}

bool AIoT::sensor(const char* capabilityId, SensorReadFn readFn,
                  uint32_t intervalMs) {
  if (!capabilityId || !capabilityId[0] || !readFn || intervalMs == 0) {
    AIOT_LOG(F("sensor: invalid registration"));
    return false;
  }
  for (const auto& s : sensors_) {
    if (s.id == capabilityId) {
      AIOT_LOGF("sensor: duplicate capability '%s'", capabilityId);
      return false;
    }
  }
  SensorChannel ch;
  ch.id = capabilityId;
  ch.fn = readFn;
  ch.intervalMs = intervalMs;
  ch.lastRunMs = millis();  // first read happens after one interval
  sensors_.push_back(ch);
  capabilityHealth_[ch.id] = "unknown";
  AIOT_LOGF("sensor: registered '%s' every %lu ms", capabilityId,
            (unsigned long)intervalMs);
  return true;
}

bool AIoT::actuator(const char* capabilityId, BoolWriteFn writeFn,
                    bool safeDefault) {
  if (!capabilityId || !capabilityId[0] || !writeFn) {
    AIOT_LOG(F("actuator: invalid registration"));
    return false;
  }
  if (findActuator(capabilityId)) {
    AIOT_LOGF("actuator: duplicate capability '%s'", capabilityId);
    return false;
  }
  ActuatorChannel ch;
  ch.id = capabilityId;
  ch.isBool = true;
  ch.boolFn = writeFn;
  ch.minValue = 0.0f;
  ch.maxValue = 1.0f;
  ch.reported = safeDefault ? "true" : "false";
  actuators_.push_back(ch);
  // Apply the safe default immediately so outputs are never floating.
  writeFn(safeDefault);
  AIOT_LOGF("actuator: registered '%s' (bool, safe=%s)", capabilityId,
            safeDefault ? "on" : "off");
  return true;
}

bool AIoT::actuator(const char* capabilityId, NumWriteFn writeFn,
                    float minValue, float maxValue, float safeDefault) {
  if (!capabilityId || !capabilityId[0] || !writeFn || minValue >= maxValue) {
    AIOT_LOG(F("actuator: invalid registration"));
    return false;
  }
  if (findActuator(capabilityId)) {
    AIOT_LOGF("actuator: duplicate capability '%s'", capabilityId);
    return false;
  }
  float safe = safeDefault < minValue ? minValue
               : safeDefault > maxValue ? maxValue
                                        : safeDefault;
  ActuatorChannel ch;
  ch.id = capabilityId;
  ch.isBool = false;
  ch.numFn = writeFn;
  ch.minValue = minValue;
  ch.maxValue = maxValue;
  char buf[32];
  snprintf(buf, sizeof(buf), "%.2f", safe);
  ch.reported = buf;
  actuators_.push_back(ch);
  writeFn(safe);
  AIOT_LOGF("actuator: registered '%s' (%.2f..%.2f, safe=%.2f)", capabilityId,
            minValue, maxValue, safe);
  return true;
}

void AIoT::loop() {
  esp_task_wdt_reset();
  if (transport_) transport_->poll();
  runStateMachine();
  if (state_ == AIoTState::ONLINE) {
    runScheduler();
    pumpQueue();
  }
  maybeSyncTime();
  esp_task_wdt_reset();
}

// ---------------------------------------------------------------------------
// State machine
// ---------------------------------------------------------------------------

void AIoT::setState(AIoTState next) {
  if (state_ == next) return;
  state_ = next;
  stateEnteredMs_ = millis();
  AIOT_LOGF("state -> %s", aiotStateName(next));
  publishStatus();
}

void AIoT::runStateMachine() {
  const uint32_t now = millis();
  switch (state_) {
    case AIoTState::BOOT: {
      // Basic self checks before touching the network.
      if (sensors_.empty() && actuators_.empty()) {
        AIOT_LOG(F("self-test: no sensors or actuators registered"));
      }
      if (!cfg_.manifestJson || !cfg_.manifestJson[0]) {
        AIOT_LOG(F("self-test: WARNING: no manifest JSON configured"));
      }
      setState(AIoTState::SELF_TEST);
      break;
    }
    case AIoTState::SELF_TEST: {
      setState(AIoTState::NETWORK_CONNECTING);
      WiFi.mode(WIFI_STA);
      WiFi.setAutoReconnect(true);
      AIOT_LOG(F("wifi: connecting (SSID hidden from logs)"));
      WiFi.begin(cfg_.wifiSsid, cfg_.wifiPass);
      break;
    }
    case AIoTState::NETWORK_CONNECTING: {
      if (WiFi.status() == WL_CONNECTED) {
        AIOT_LOGF("wifi: connected, IP %s", WiFi.localIP().toString().c_str());
        configTime(0, 0, "pool.ntp.org", "time.nist.gov");
        setState(AIoTState::MQTT_CONNECTING);
        startMqttConnect();
      } else if (now - stateEnteredMs_ > kWifiTimeoutMs) {
        AIOT_LOG(F("wifi: connect timeout"));
        setState(AIoTState::RECONNECTING);
      }
      esp_task_wdt_reset();
      break;
    }
    case AIoTState::MQTT_CONNECTING: {
      if (mqttSession_) {
        mqttSession_ = false;
        setState(AIoTState::REGISTERING);
        doRegistration();
      } else if (!transport_ || !transport_->isConnected()) {
        if (now - stateEnteredMs_ > kMqttTimeoutMs) {
          AIOT_LOG(F("mqtt: connect timeout"));
          setState(AIoTState::RECONNECTING);
        }
      }
      break;
    }
    case AIoTState::REGISTERING: {
      // (Re)subscribe every pass until the broker confirms.
      if (transport_ && transport_->subscribe(topicCommand_, 1)) {
        setState(AIoTState::ONLINE);
        reconnectDelayMs_ = 5000;
        lastHeartbeatMs_ = now;
      } else if (now - stateEnteredMs_ > kSubscribeTimeoutMs) {
        AIOT_LOG(F("mqtt: subscribe timeout"));
        setState(AIoTState::RECONNECTING);
      }
      break;
    }
    case AIoTState::ONLINE: {
      if (WiFi.status() != WL_CONNECTED) {
        AIOT_LOG(F("wifi: lost"));
        setState(AIoTState::OFFLINE);
      } else if (transport_ && !transport_->isConnected()) {
        AIOT_LOG(F("mqtt: connection lost"));
        setState(AIoTState::RECONNECTING);
      }
      break;
    }
    case AIoTState::OFFLINE: {
      setState(AIoTState::RECONNECTING);
      break;
    }
    case AIoTState::RECONNECTING: {
      if (now - stateEnteredMs_ > reconnectDelayMs_) {
        reconnectDelayMs_ = reconnectDelayMs_ * 2 > kReconnectMaxMs
                                ? kReconnectMaxMs
                                : reconnectDelayMs_ * 2;
        if (WiFi.status() == WL_CONNECTED) {
          setState(AIoTState::MQTT_CONNECTING);
          startMqttConnect();
        } else {
          setState(AIoTState::NETWORK_CONNECTING);
          WiFi.begin(cfg_.wifiSsid, cfg_.wifiPass);
        }
      }
      break;
    }
  }
}

void AIoT::startMqttConnect() {
  if (!transport_) {
    transport_ = new EspMqttClientTransport();
  }
  transport_->setMessageCallback(
      [this](const char* topic, const uint8_t* payload, size_t length) {
        onMqttMessage(topic, payload, length);
      });
  transport_->setConnectCallback([this](bool sessionPresent) {
    onMqttConnected(sessionPresent);
  });
  transport_->setDisconnectCallback(
      [this](int reason) { onMqttDisconnected(reason); });

  // Last-will: retained presence "offline" so the platform notices drops.
  char will[256];
  snprintf(will, sizeof(will),
           "{\"protocolVersion\":\"1.0\",\"deviceId\":\"%s\",\"online\":false,"
           "\"at\":0,\"firmware\":\"%s\"}",
           cfg_.deviceId, AIOT_FIRMWARE_VERSION);
  AIOT_LOG(F("mqtt: connecting (credentials hidden from logs)"));
  transport_->open(cfg_.mqttHost, cfg_.mqttPort, cfg_.deviceId, cfg_.mqttUser,
                   cfg_.mqttPass, cfg_.tls, topicPresence_,
                   reinterpret_cast<const uint8_t*>(will), strlen(will));
}

void AIoT::doRegistration() {
  AIOT_LOG(F("mqtt: registering (manifest + presence)"));
  if (cfg_.manifestJson && cfg_.manifestJson[0]) {
    enqueueJson(topicManifest_, cfg_.manifestJson, 1, true, 1);
  }
  publishPresence(true);
}

void AIoT::onMqttConnected(bool sessionPresent) {
  (void)sessionPresent;
  AIOT_LOG(F("mqtt: connected"));
  mqttSession_ = true;
}

void AIoT::onMqttDisconnected(int reason) {
  AIOT_LOGF("mqtt: disconnected (reason %d)", reason);
  if (state_ == AIoTState::ONLINE || state_ == AIoTState::MQTT_CONNECTING ||
      state_ == AIoTState::REGISTERING) {
    setState(AIoTState::RECONNECTING);
  }
}

void AIoT::onMqttMessage(const char* topic, const uint8_t* payload,
                         size_t length) {
  if (!topic || strcmp(topic, topicCommand_) != 0) return;
  if (length == 0 || length > kMaxInboundPayload) {
    AIOT_LOG(F("command: payload size out of bounds, ignored"));
    return;
  }
  handleCommand(payload, length);
}

// ---------------------------------------------------------------------------
// Scheduler: sensor reads, heartbeat, queue pump, NTP
// ---------------------------------------------------------------------------

void AIoT::runScheduler() {
  const uint32_t now = millis();
  for (auto& s : sensors_) {
    if ((int32_t)(now - s.lastRunMs) < (int32_t)s.intervalMs) continue;
    s.lastRunMs = now;
    float value = s.fn();
    if (isnan(value)) {
      sensorErrors_++;
      capabilityHealth_[s.id] = "error";
      AIOT_LOGF("sensor '%s': read failed", s.id.c_str());
      continue;
    }
    capabilityHealth_[s.id] = "good";
    publishTelemetry(s.id, value);
  }
  if ((int32_t)(now - lastHeartbeatMs_) >= (int32_t)kHeartbeatMs) {
    lastHeartbeatMs_ = now;
    publishHealth();
  }
}

void AIoT::pumpQueue() {
  if (!transport_ || !transport_->isConnected()) return;
  while (!queue_.empty()) {
    const QueuedMessage& m = queue_.front();
    if (!transport_->publish(m.topic, m.payload, m.length, m.qos, m.retain)) {
      break;  // keep the rest for the next pass
    }
    queue_.erase(queue_.begin());
  }
}

void AIoT::maybeSyncTime() {
  if (timeSynced_) return;
  if (WiFi.status() != WL_CONNECTED) return;
  const uint32_t now = millis();
  if (now - lastNtpPollMs_ < kNtpPollMs) return;
  lastNtpPollMs_ = now;
  time_t t = time(nullptr);
  if (t > 946684800) {  // after 2000-01-01: clock is real
    timeSynced_ = true;
    AIOT_LOG(F("ntp: clock synchronized"));
  }
}

uint64_t AIoT::currentTimeMs() {
  if (timeSynced_) {
    return (uint64_t)time(nullptr) * 1000ULL;
  }
  return (uint64_t)millis();
}

// ---------------------------------------------------------------------------
// Bounded telemetry queue: max 20, oldest lowest-priority dropped first
// ---------------------------------------------------------------------------

void AIoT::enqueue(const char* topic, const uint8_t* payload, size_t length,
                   uint8_t qos, bool retain, uint8_t priority) {
  if (!topic || !payload ||
      length >= sizeof(QueuedMessage::payload)) {
    AIOT_LOG(F("queue: message too large, dropped"));
    return;
  }
  if (queue_.size() >= kQueueMax) {
    size_t drop = 0;
    uint8_t worst = 255;
    for (size_t i = 0; i < queue_.size(); i++) {
      if (queue_[i].priority < worst) {
        worst = queue_[i].priority;
        drop = i;
      }
    }
    queue_.erase(queue_.begin() + drop);
  }
  QueuedMessage m;
  m.priority = priority;
  m.qos = qos;
  m.retain = retain;
  strncpy(m.topic, topic, sizeof(m.topic) - 1);
  memcpy(m.payload, payload, length);
  m.length = length;
  queue_.push_back(m);
}

void AIoT::enqueueJson(const char* topic, const char* json, uint8_t qos,
                       bool retain, uint8_t priority) {
  enqueue(topic, reinterpret_cast<const uint8_t*>(json), strlen(json), qos,
          retain, priority);
}

// ---------------------------------------------------------------------------
// Publishers (canonical protocol v1 JSON via ArduinoJson)
// ---------------------------------------------------------------------------

void AIoT::publishStatus() {
  JsonDocument doc;
  doc["protocolVersion"] = AIOT_PROTOCOL_VERSION;
  doc["deviceId"] = cfg_.deviceId ? cfg_.deviceId : "";
  doc["state"] = aiotStateName(state_);
  doc["at"] = (double)currentTimeMs();
  char buf[256];
  size_t n = serializeJson(doc, buf, sizeof(buf));
  (void)n;
  enqueueJson(topicStatus_, buf, 1, false, 1);
}

void AIoT::publishTelemetry(const String& capabilityId, float value) {
  JsonDocument doc;
  doc["protocolVersion"] = AIOT_PROTOCOL_VERSION;
  doc["deviceId"] = cfg_.deviceId ? cfg_.deviceId : "";
  char mid[80];
  snprintf(mid, sizeof(mid), "%s-%lu", cfg_.deviceId ? cfg_.deviceId : "dev",
           (unsigned long)sequence_);
  doc["messageId"] = mid;
  if (timeSynced_) {
    doc["timestamp"] = (double)currentTimeMs();
    doc["timeQuality"] = "synchronized";
  } else {
    doc["timestamp"] = 0;
    doc["timeQuality"] = "unsynchronized";
  }
  doc["sequence"] = (double)sequence_;
  sequence_++;
  doc["values"][capabilityId] = value;
  char buf[512];
  serializeJson(doc, buf, sizeof(buf));
  lastTelemetryAt_ = millis();
  enqueueJson(topicTelemetry_, buf, 0, false, 0);
}

void AIoT::publishHealth() {
  JsonDocument doc;
  doc["protocolVersion"] = AIOT_PROTOCOL_VERSION;
  doc["deviceId"] = cfg_.deviceId ? cfg_.deviceId : "";
  doc["uptime"] = (double)(millis() / 1000);
  doc["freeHeap"] = (double)ESP.getFreeHeap();
  doc["wifiRssi"] = WiFi.RSSI();
  doc["mqtt"] = (transport_ && transport_->isConnected()) ? "connected"
                                                          : "disconnected";
  doc["firmware"] = AIOT_FIRMWARE_VERSION;
  doc["sensorErrors"] = (double)sensorErrors_;
  JsonObject ch = doc["capabilityHealth"].to<JsonObject>();
  for (const auto& kv : capabilityHealth_) {
    ch[kv.first] = kv.second;
  }
  doc["lastTelemetryAt"] = (double)lastTelemetryAt_;
  doc["at"] = (double)currentTimeMs();
  char buf[768];
  serializeJson(doc, buf, sizeof(buf));
  enqueueJson(topicHealth_, buf, 0, false, 1);
}

void AIoT::publishPresence(bool online) {
  JsonDocument doc;
  doc["protocolVersion"] = AIOT_PROTOCOL_VERSION;
  doc["deviceId"] = cfg_.deviceId ? cfg_.deviceId : "";
  doc["online"] = online;
  doc["at"] = (double)currentTimeMs();
  doc["firmware"] = AIOT_FIRMWARE_VERSION;
  char buf[256];
  serializeJson(doc, buf, sizeof(buf));
  enqueueJson(topicPresence_, buf, 1, true, 1);
}

void AIoT::publishCommandResult(const String& commandId, const char* status,
                                const char* reason, ActuatorChannel* act) {
  JsonDocument doc;
  doc["kind"] = "result";
  doc["protocolVersion"] = AIOT_PROTOCOL_VERSION;
  doc["commandId"] = commandId;
  doc["deviceId"] = cfg_.deviceId ? cfg_.deviceId : "";
  doc["status"] = status;
  if (reason && reason[0]) doc["reason"] = reason;
  if (act) {
    // reportedState carries the post-execution value as real JSON.
    JsonDocument rdoc;
    if (!deserializeJson(rdoc, act->reported)) {
      doc["reportedState"][act->id] = rdoc.as<JsonVariant>();
    }
  }
  doc["at"] = (double)currentTimeMs();
  char buf[512];
  serializeJson(doc, buf, sizeof(buf));
  enqueueJson(topicCommand_, buf, 1, false, 1);
}

// ---------------------------------------------------------------------------
// Command handling
// ---------------------------------------------------------------------------

AIoT::ActuatorChannel* AIoT::findActuator(const char* capabilityId) {
  if (!capabilityId) return nullptr;
  for (auto& a : actuators_) {
    if (a.id == capabilityId) return &a;
  }
  return nullptr;
}

bool AIoT::isDuplicateCommand(const String& commandId) {
  for (size_t i = 0; i < kCommandCacheSize; i++) {
    if (commandCache_[i] == commandId) return true;
  }
  return false;
}

void AIoT::rememberCommand(const String& commandId) {
  commandCache_[commandCachePos_] = commandId;
  commandCachePos_ = (commandCachePos_ + 1) % kCommandCacheSize;
}

void AIoT::handleCommand(const uint8_t* payload, size_t length) {
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, payload, length);
  if (err) {
    AIOT_LOG(F("command: invalid JSON, ignored"));
    return;
  }
  const char* kind = doc["kind"] | "";
  if (strcmp(kind, "command") != 0) return;  // results echo back; ignore

  const char* target = doc["deviceId"] | "";
  if (!cfg_.deviceId || strcmp(target, cfg_.deviceId) != 0) return;

  String commandId = doc["commandId"] | "";
  if (commandId.isEmpty()) {
    AIOT_LOG(F("command: missing commandId, ignored"));
    return;
  }
  if (isDuplicateCommand(commandId)) {
    AIOT_LOGF("command %s: duplicate", commandId.c_str());
    publishCommandResult(commandId, "DUPLICATE", "command already processed",
                         nullptr);
    return;
  }
  rememberCommand(commandId);

  // Expiry is enforced against NTP time; without sync we accept the command
  // (documented limitation) rather than bricking remote control.
  double expiresAt = doc["expiresAt"] | 0.0;
  if (timeSynced_ && expiresAt > 0 &&
      (uint64_t)expiresAt <= currentTimeMs()) {
    AIOT_LOGF("command %s: expired", commandId.c_str());
    publishCommandResult(commandId, "EXPIRED", "command expired", nullptr);
    return;
  }

  const char* capabilityId = doc["capabilityId"] | "";
  ActuatorChannel* act = findActuator(capabilityId);
  if (!act) {
    AIOT_LOGF("command %s: unknown capability '%s'", commandId.c_str(),
              capabilityId);
    publishCommandResult(commandId, "REJECTED", "unknown capability", nullptr);
    return;
  }
  const char* action = doc["action"] | "";
  if (strcmp(action, "set") != 0) {
    publishCommandResult(commandId, "REJECTED", "unsupported action (use 'set')",
                         nullptr);
    return;
  }
  JsonVariant value = doc["params"]["value"];
  if (value.isNull()) {
    publishCommandResult(commandId, "REJECTED", "missing params.value", nullptr);
    return;
  }

  AIOT_LOGF("command %s: %s <- set", commandId.c_str(), capabilityId);
  publishCommandResult(commandId, "ACKNOWLEDGED", nullptr, nullptr);

  if (act->isBool) {
    if (!value.is<bool>()) {
      publishCommandResult(commandId, "REJECTED",
                           "params.value must be boolean", nullptr);
      return;
    }
    bool v = value.as<bool>();
    act->boolFn(v);
    act->reported = v ? "true" : "false";
  } else {
    if (!value.is<float>() && !value.is<int>()) {
      publishCommandResult(commandId, "REJECTED",
                           "params.value must be a number", nullptr);
      return;
    }
    float v = value.as<float>();
    if (v < act->minValue || v > act->maxValue) {
      AIOT_LOGF("command %s: value %.2f out of range [%.2f, %.2f]",
                commandId.c_str(), v, act->minValue, act->maxValue);
      publishCommandResult(commandId, "REJECTED", "params.value out of range",
                           nullptr);
      return;
    }
    act->numFn(v);
    char buf[32];
    snprintf(buf, sizeof(buf), "%.2f", v);
    act->reported = buf;
  }
  publishCommandResult(commandId, "SUCCEEDED", nullptr, act);
}
